# =============================================================================
# DevOps Setup Configuration
#
# Copy this file to .env and fill in your credentials
# Never commit the .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub & GHCR (REQUIRED)
# -----------------------------------------------------------------------------
# Create a Personal Access Token (PAT) at:
# https://github.com/settings/tokens
#
# Required scopes for GHCR:
# - read:packages  (required for pulling images)
# - write:packages (required for pushing images)
# -----------------------------------------------------------------------------

GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=ghp_your_github_personal_access_token

# -----------------------------------------------------------------------------
# GHCR (GitHub Container Registry) - Optional Override
# -----------------------------------------------------------------------------
# Uses GITHUB_TOKEN/GITHUB_USERNAME by default
# Only set these if using different credentials for GHCR
# -----------------------------------------------------------------------------

# GHCR_USERNAME=your_github_username
# GHCR_TOKEN=ghp_your_github_pat

# -----------------------------------------------------------------------------
# Docker Hub (OPTIONAL)
# -----------------------------------------------------------------------------
# Only required if you need to pull/push from Docker Hub
# Create an access token at:
# https://hub.docker.com/settings/security
# -----------------------------------------------------------------------------

# DOCKER_USERNAME=your_dockerhub_username
# DOCKER_PASSWORD=your_dockerhub_password_or_access_token

# -----------------------------------------------------------------------------
# Configuration Options (OPTIONAL)
# -----------------------------------------------------------------------------

# Auto-restart Docker daemon after configuration (requires sudo)
DOCKER_AUTO_RESTART=true

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Run verification phase
VERIFICATION_ENABLED=true

# -----------------------------------------------------------------------------
# Docker Deployment Configuration (OPTIONAL)
# -----------------------------------------------------------------------------

# Deployment Mode: production or staging
DEPLOYMENT_MODE=production

# Container Name: app-prod, app-staging, or custom
CONTAINER_NAME=app-prod

# Host Port for container mapping (container exposes port 8080)
PORT=80

# GHCR Image to pull from
IMAGE_NAME=ghcr.io/your-org/your-repo:latest

# Auto-Deploy: Enable automatic deployment via cron
AUTO_DEPLOY=false

# Cron Interval for auto-deploy (checks every N minutes)
CRON_INTERVAL="*/5 * * * *"

# -----------------------------------------------------------------------------
# Webhook configuration (optional)
# -----------------------------------------------------------------------------

WEBHOOK_ENABLED=false
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your-webhook-secret-here

